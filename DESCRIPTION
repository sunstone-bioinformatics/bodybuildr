Package: bodybuildr
Type: Package
Title: Bodybuildr creates infographics row by row
Version: 0.4.3
Authors@R: c(
    person(
      "Rafael", "Leon",
      email = "rafa.leon190@gmail.com",
      role = c("aut", "cre")
